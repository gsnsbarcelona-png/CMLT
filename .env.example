# --- X (Twitter) API - OAuth 1.0a User Context ---
# Las 4 keys se obtienen en developer.x.com, seccion "Keys and tokens" de tu app.
# X_API_KEY / X_API_SECRET = "API Key and Secret" (Consumer Keys)
X_API_KEY=
X_API_SECRET=
# X_ACCESS_TOKEN / X_ACCESS_TOKEN_SECRET = "Access Token and Secret"
# IMPORTANTE: generar estos DESPUES de configurar los permisos de la app en
# "Read and Write" (si ya los habias generado en modo Read, hay que
# regenerarlos, si no la publicacion falla con 403).
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LoL Esports (calendario LES/LEC) ---
# Key publica embebida en el frontend de lolesports.com. Ya viene con un
# valor funcional por defecto; solo hace falta tocar esto si Riot la rota.
LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z

# --- gol.gg (stats curiosas) ---
# Hay que actualizarlas en cada split nuevo: buscar el nombre exacto del
# torneo en https://gol.gg/tournament/list/ (ej. "LES 2026 Autumn").
GOLGG_SEASON=S16
GOLGG_TOURNAMENT=LES 2026 Summer
# Torneos que forman "todo el ano" para el scope "Todo el ano" de Stats.
# Incluye kick-off y playoffs para capturar rivalidades con mas de un cruce en el ano.
GOLGG_YEAR_TOURNAMENTS=LES 2026 Kick-off Tournament,LES 2026 Spring,LES 2026 Spring Playoffs,LES 2026 Summer,LES 2026 Summer Playoffs
# Para comparativas LES-LEC. En gol.gg el nombre de la LEC lleva "Season" al final.
LEC_TOURNAMENT=LEC 2026 Summer Season

# --- Arrobas / hashtags al final de los tweets generados ---
LEAGUE_HANDLE_LES=@LESESPORTS
LEAGUE_HANDLE_LEC=@LEC
# Separados por espacio.
CUSTOM_HASHTAGS=#LT
# "Nombre de equipo:@handle" separados por coma -- solo se usan en Stats.
# OJO: UB Alma Mater queda afuera a proposito -- se probaron @UniBarcelona y
# @EsportsUB y ninguno de los dos es la cuenta del equipo de LoL. Agregalo aca
# si conseguis el handle real.
TEAM_HANDLES=Barca eSports:@FCBeSports,Falke Esports:@FALKE_EC,GIANTX iTero:@GIANTXLeague,LUA Gaming:@LUAGaming_,Movistar KOI Fenix:@MovistarKOILoL,Team Heretics Academy:@HereticsLES,UCAM Esports:@UCAM_esports

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/tweets.db
