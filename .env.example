# --- X (Twitter) API - OAuth 1.0a User Context ---
# Las 4 keys se obtienen en developer.x.com, sección "Keys and tokens" de tu app.
# X_API_KEY / X_API_SECRET = "API Key and Secret" (Consumer Keys)
X_API_KEY=
X_API_SECRET=
# X_ACCESS_TOKEN / X_ACCESS_TOKEN_SECRET = "Access Token and Secret"
# IMPORTANTE: generar estos DESPUÉS de configurar los permisos de la app en
# "Read and Write" (si ya los habías generado en modo Read, hay que
# regenerarlos, si no la publicación falla con 403).
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LoL Esports (calendario LES/LEC) ---
# Key pública embebida en el frontend de lolesports.com. Ya viene con un
# valor funcional por defecto; solo hace falta tocar esto si Riot la rota.
LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z

# --- gol.gg (stats curiosas) ---
# Hay que actualizarlas en cada split nuevo: buscar el nombre exacto del
# torneo en https://gol.gg/tournament/list/ (ej. "LES 2026 Autumn").
# Con true (por defecto) la temporada y los torneos se descubren solos desde gol.gg;
# los valores de abajo son el respaldo. false = usar siempre los de abajo.
GOLGG_AUTODISCOVER=true
GOLGG_SEASON=S16
GOLGG_TOURNAMENT=LES 2026 Summer
# Torneos que forman "todo el año" para el scope "Todo el año" de Stats.
# Incluye kick-off y playoffs para capturar rivalidades con más de un cruce en el año.
GOLGG_YEAR_TOURNAMENTS=LES 2026 Kick-off Tournament,LES 2026 Spring,LES 2026 Spring Playoffs,LES 2026 Summer,LES 2026 Summer Playoffs
# Para comparativas LES-LEC. En gol.gg el nombre de la LEC lleva "Season" al final.
LEC_TOURNAMENT=LEC 2026 Summer Season
# Torneos de EMEA Masters en gol.gg -- H2H los usa además de los de LES para
# no devolver historial/forma vacíos cuando un equipo de LES juega ahí contra
# un rival que nunca jugó en LES. Actualizar en cada split nuevo (buscar con
# GET /api/generate/stats/available-tournaments?region=WR).
EMEA_MASTERS_TOURNAMENTS=EMEA Masters 2026 Winter,EMEA Masters 2026 Spring Play-In,EMEA Masters 2026 Spring Main Event

# --- Arrobas / hashtags al final de los tweets generados ---
LEAGUE_HANDLE_LES=@LESESPORTS
LEAGUE_HANDLE_LEC=@LEC
LEAGUE_HANDLE_EMEA_MASTERS=@EMEAmasters
# Separados por espacio.
CUSTOM_HASHTAGS=#LT
# "Nombre de equipo:@handle" separados por coma -- solo se usan en Stats.
# OJO: UB Alma Mater queda afuera a propósito -- se probaron @UniBarcelona y
# @EsportsUB y ninguno de los dos es la cuenta del equipo de LoL. Agregalo aca
# si conseguís el handle real.
TEAM_HANDLES=Barca eSports:@FCBeSports,Falke Esports:@FALKE_EC,GIANTX iTero:@GIANTXLeague,LUA Gaming:@LUAGaming_,Movistar KOI Fenix:@MovistarKOILoL,Team Heretics Academy:@HereticsLES,UCAM Esports:@UCAM_esports

# --- App ---
DATABASE_URL=sqlite:///./data/tweets.db

# --- Login (necesario si la app se expone en internet, ej. para usarla desde el móvil) ---
# Vacía = sin login (uso local). Si la cargas, la app pide esta contraseña.
APP_PASSWORD=
# Clave para firmar la cookie de sesión. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si queda vacía, las sesiones se pierden cada vez que se reinicia el server.
SESSION_SECRET=
